# Protected processing remains disabled unless the deployment has been
# reviewed under the firm's BAA and security controls.
PHI_MODE=disabled

# Future protected service configuration (do not use in the public pilot).
# DATABASE_URL=
# AWS_ROLE_ARN=
# OPENAI_API_KEY=
# OPENAI_PROJECT_ID=

# Offline local-appliance profile. Enable only on a managed workstation and
# bind the application to a loopback interface.
LOCAL_ONLY_MODE=disabled

# Local model host. "ollama" is the default; "openai" targets any
# OpenAI-compatible loopback server such as oMLX. Both must stay on loopback.
# LOCAL_LLM_PROVIDER=ollama
#
# --- Ollama ---
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen3:8b
# LOCAL_VISION_MODEL=qwen3-vl:8b
#
# --- oMLX (OpenAI-compatible) ---
# Model names are the directory basename under the oMLX model dir, not the
# Hugging Face path. The API key is required when oMLX auth is enabled.
# LOCAL_LLM_PROVIDER=openai
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000
# LOCAL_LLM_MODEL=Qwen3-8B-4bit
# LOCAL_VISION_MODEL=Qwen3-VL-8B-Instruct-4bit
# LOCAL_LLM_API_KEY=
# LOCAL_DATA_DIRECTORY=/absolute/path/to/encrypted-verity-data
# PADDLEOCR_PYTHON=/absolute/path/to/offline-paddleocr/bin/python
# PADDLE_OCR_MODEL_DIR=/absolute/path/to/ppocr-models
